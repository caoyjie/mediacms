# MediaCMS Production Environment Configuration
# Copy this to /etc/mediacms/production.env and fill in real values
# NEVER commit production secrets to the repository

# Compose project name (distinct from mattermost/metabase)
COMPOSE_PROJECT_NAME=mediacms-prod

# Image version - replace REPLACEME with actual release tag
MEDIACMS_IMAGE=ghcr.io/caoyjie/mediacms:REPLACEME

# Web service port (port 443 is owned by xray, so we use 8080 internally)
# External reverse proxy must forward HTTPS traffic to this port
MEDIACMS_WEB_PORT=8080

# Application Configuration
FRONTEND_HOST=https://your-domain.com
PORTAL_NAME=MediaCMS Production
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_50_CHARS_MIN

# Admin user (created during initial migration)
ADMIN_USER=admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=mediacms
POSTGRES_USER=mediacms
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Redis Configuration
REDIS_LOCATION=redis://redis:6379/1

# AWS Configuration (MUST use prod environment)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ENVIRONMENT=prod

# AWS Runtime Credentials (extract from prod stack using deploy/scripts/extract_runtime_aws_env.sh)
AWS_ACCESS_KEY_ID=REPLACE_FROM_STACK_SECRETS
AWS_SECRET_ACCESS_KEY=REPLACE_FROM_STACK_SECRETS
AWS_MEDIA_BUCKET=mediacms-ACCOUNT-us-east-1-prod
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::ACCOUNT:role/mediacms-prod-mediaconvert

# MediaConvert Templates (must match prod stack)
AWS_MEDIACONVERT_VIDEO_TEMPLATE=mediacms-prod-video-hls-v1
AWS_MEDIACONVERT_AUDIO_TEMPLATE=mediacms-prod-audio-hls-v1

# CloudFront Playback Configuration (extract from prod stack - REQUIRED for signed URLs)
# AWS_CLOUDFRONT_DISTRIBUTION_ID=E***************
# AWS_CLOUDFRONT_KEY_GROUP_ID=****-****-****
# AWS_CLOUDFRONT_PRIVATE_KEY_PATH=/etc/mediacms/secrets/cloudfront-private-key.pem
# AWS_CLOUDFRONT_PUBLIC_KEY_ID=K***************

# Worker Configuration (MUST stay at 1 due to memory constraints)
CELERY_WORKER_CONCURRENCY=1

# Timezone
TZ=UTC

# DEBUG MODE (MUST be False in production)
DEBUG=False
